  {
    "id": "p1-1",
    "front": "What is the first phase of CPMAI?",
    "back": "Phase I — Business Understanding",
    "topicId": "p1"
  },
  {
    "id": "p1-2",
    "front": "What key question does Phase I answer?",
    "back": "\"WHY are we doing this, and do we even need AI?\"",
    "topicId": "p1"
  },
  {
    "id": "p1-3",
    "front": "CPMAI is built on which older methodology?",
    "back": "CRISP-DM",
    "topicId": "p1"
  },
  {
    "id": "p1-4",
    "front": "Name the 7 Patterns of AI",
    "back": "Hyperpersonalization, Autonomous Systems, Predictive Analytics, Conversation & Human Interaction, Patterns & Anomalies, Recognition, Goal-Driven Systems",
    "topicId": "p1"
  },
  {
    "id": "p1-5",
    "front": "Fraud detection maps to which pattern?",
    "back": "Patterns & Anomalies",
    "topicId": "p1"
  },
  {
    "id": "p1-6",
    "front": "Product recommendations map to which pattern?",
    "back": "Hyperpersonalization",
    "topicId": "p1"
  },
  {
    "id": "p1-7",
    "front": "Chatbots map to which pattern?",
    "back": "Conversation & Human Interaction",
    "topicId": "p1"
  },
  {
    "id": "p1-8",
    "front": "What tool suits repetitive rule-based tasks instead of AI?",
    "back": "RPA (Robotic Process Automation)",
    "topicId": "p1"
  },
  {
    "id": "p1-9",
    "front": "What is the CPMAI mantra set in Phase I?",
    "back": "Think Big, Start Small, Iterate Often",
    "topicId": "p1"
  },
  {
    "id": "p1-10",
    "front": "KPI vs model metric — which defines project success?",
    "back": "Business KPI",
    "topicId": "p1"
  },
  {
    "id": "p1-11",
    "front": "What formal decision is made in Phase I?",
    "back": "Go / No-Go decision",
    "topicId": "p1"
  },
  {
    "id": "p1-12",
    "front": "How often is Phase I performed?",
    "back": "At the start of every iteration",
    "topicId": "p1"
  },
  {
    "id": "p1-13",
    "front": "Traditional software is deterministic; AI is ___?",
    "back": "Probabilistic",
    "topicId": "p1"
  },
  {
    "id": "p1-14",
    "front": "Top reason AI projects fail?",
    "back": "Poor/missing business understanding",
    "topicId": "p1"
  },
  {
    "id": "p1-15",
    "front": "What comes immediately after Phase I?",
    "back": "Phase II — Data Understanding",
