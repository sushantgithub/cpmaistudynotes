  {
    "id": "p5-1",
    "front": "Two levels of CPMAI evaluation?",
    "back": "Technical and business (plus ethical checks)",
    "topicId": "p5"
  },
  {
    "id": "p5-2",
    "front": "Formula for precision?",
    "back": "TP / (TP + FP)",
    "topicId": "p5"
  },
  {
    "id": "p5-3",
    "front": "Formula for recall?",
    "back": "TP / (TP + FN)",
    "topicId": "p5"
  },
  {
    "id": "p5-4",
    "front": "Formula for F1?",
    "back": "2 × (P × R) / (P + R)",
    "topicId": "p5"
  },
  {
    "id": "p5-5",
    "front": "Type I vs Type II error?",
    "back": "Type I = false positive; Type II = false negative",
    "topicId": "p5"
  },
  {
    "id": "p5-6",
    "front": "Metric for cancer screening priority?",
    "back": "Recall",
    "topicId": "p5"
  },
  {
    "id": "p5-7",
    "front": "Metric when false alarms are costly?",
    "back": "Precision",
    "topicId": "p5"
  },
  {
    "id": "p5-8",
    "front": "What is the accuracy paradox?",
    "back": "High accuracy on imbalanced data while missing the rare class entirely",
    "topicId": "p5"
  },
  {
    "id": "p5-9",
    "front": "AUC of 0.5 means?",
    "back": "Random guessing",
    "topicId": "p5"
  },
  {
    "id": "p5-10",
    "front": "Two regression metrics?",
    "back": "MAE and RMSE (also R²)",
    "topicId": "p5"
  },
  {
    "id": "p5-11",
    "front": "Who decides the classification threshold tradeoff?",
    "back": "The business (cost of FP vs FN)",
    "topicId": "p5"
  },
  {
    "id": "p5-12",
    "front": "What is shadow testing?",
    "back": "Running the model in parallel without acting on outputs",
    "topicId": "p5"
  },
  {
    "id": "p5-13",
    "front": "What must final metrics be computed on?",
    "back": "The untouched test set",
    "topicId": "p5"
  },
  {
    "id": "p5-14",
    "front": "Three possible Phase V outcomes?",
    "back": "Deploy, iterate, stop",
    "topicId": "p5"
  },
  {
    "id": "p5-15",
    "front": "What non-technical audits happen in Phase V?",
    "back": "Fairness/bias and explainability reviews",
    "topicId": "p5"
  },
  {
    "id": "p6-1",
    "front": "What is Phase VI also commonly called?",
    "back": "Model Operationalization / MLOps stage",
    "topicId": "p6"
  },
  {
    "id": "p6-2",
    "front": "Does deployment end the AI project?",
    "back": "No — monitoring, retraining, governance continue",
    "topicId": "p6"
  },
  {
    "id": "p6-3",
    "front": "Data drift vs concept drift?",
    "back": "Inputs change vs input→output relationship changes",
    "topicId": "p6"
  },
  {
    "id": "p6-4",
    "front": "Serving mode for millisecond decisions?",
    "back": "Real-time (online) inference",
    "topicId": "p6"
  },
  {
    "id": "p6-5",
    "front": "Serving mode for nightly bulk scoring?",
    "back": "Batch inference",
    "topicId": "p6"
  },
  {
    "id": "p6-6",
    "front": "Model runs on the device itself — called?",
    "back": "Edge deployment",
    "topicId": "p6"
  },
  {
    "id": "p6-7",
    "front": "Parallel run with no live impact?",
    "back": "Shadow deployment",
    "topicId": "p6"
  },
  {
    "id": "p6-8",
    "front": "Gradual rollout to small traffic first?",
    "back": "Canary release",
    "topicId": "p6"
  },
  {
    "id": "p6-9",
    "front": "Three retraining trigger styles?",
    "back": "Scheduled, trigger-based (drift/alerts), continuous",
    "topicId": "p6"
  },
  {
    "id": "p6-10",
    "front": "What is a model registry?",
    "back": "Catalog of model versions and lifecycle stages",
    "topicId": "p6"
  },
  {
    "id": "p6-11",
    "front": "What is a feature store?",
    "back": "Central feature repository ensuring training-serving consistency",
    "topicId": "p6"
  },
  {
    "id": "p6-12",
    "front": "What is training-serving skew?",
    "back": "Production features differ from training features",
    "topicId": "p6"
  },
  {
    "id": "p6-13",
    "front": "What five areas should monitoring cover?",
    "back": "Performance, drift, business KPI, operations, fairness",
    "topicId": "p6"
  },
  {
    "id": "p6-14",
    "front": "What is human-in-the-loop?",
    "back": "Human review/approval inside the AI decision flow",
    "topicId": "p6"
  },
  {
    "id": "p6-15",
    "front": "Where do production learnings go in CPMAI?",
    "back": "Into the next iteration — back to Phase I",
