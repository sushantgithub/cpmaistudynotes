  },
  {
    "id": "p2-1",
    "front": "What question does Phase II answer?",
    "back": "\"WHAT data do we need, and is it good enough?\"",
    "topicId": "p2"
  },
  {
    "id": "p2-2",
    "front": "What does GIGO stand for?",
    "back": "Garbage In, Garbage Out",
    "topicId": "p2"
  },
  {
    "id": "p2-3",
    "front": "Three broad data types?",
    "back": "Structured, semi-structured, unstructured",
    "topicId": "p2"
  },
  {
    "id": "p2-4",
    "front": "% of enterprise data that is unstructured?",
    "back": "~80%",
    "topicId": "p2"
  },
  {
    "id": "p2-5",
    "front": "Name the Big Data V's",
    "back": "Volume, Variety, Velocity, Veracity (+Value)",
    "topicId": "p2"
  },
  {
    "id": "p2-6",
    "front": "Six data quality dimensions?",
    "back": "Accuracy, Completeness, Consistency, Timeliness, Validity, Uniqueness",
    "topicId": "p2"
  },
  {
    "id": "p2-7",
    "front": "Missing values violate which dimension?",
    "back": "Completeness",
    "topicId": "p2"
  },
  {
    "id": "p2-8",
    "front": "Duplicates violate which dimension?",
    "back": "Uniqueness",
    "topicId": "p2"
  },
  {
    "id": "p2-9",
    "front": "What is EDA?",
    "back": "Exploratory Data Analysis — initial statistical exploration",
    "topicId": "p2"
  },
  {
    "id": "p2-10",
    "front": "Is data cleaned in Phase II?",
    "back": "No — cleaning happens in Phase III",
    "topicId": "p2"
  },
  {
    "id": "p2-11",
    "front": "What is PII?",
    "back": "Personally Identifiable Information",
    "topicId": "p2"
  },
  {
    "id": "p2-12",
    "front": "What decision ends Phase II?",
    "back": "Data go/no-go",
    "topicId": "p2"
  },
  {
    "id": "p2-13",
    "front": "Data trapped in one department is called?",
    "back": "A data silo",
    "topicId": "p2"
  },
  {
    "id": "p2-14",
    "front": "Whose needs define data requirements?",
    "back": "The business problem from Phase I",
    "topicId": "p2"
  },
  {
    "id": "p2-15",
    "front": "What is data lineage?",
    "back": "The record of data's origin and transformations",
    "topicId": "p2"
  },
  {
    "id": "p3-1",
    "front": "Which phase takes the most effort in AI projects?",
    "back": "Phase III — Data Preparation (60–80%)",
    "topicId": "p3"
  },
  {
    "id": "p3-2",
    "front": "What is imputation?",
    "back": "Filling in missing values",
    "topicId": "p3"
  },
  {
    "id": "p3-3",
    "front": "Best imputation for numeric data with outliers?",
    "back": "Median",
    "topicId": "p3"
  },
  {
    "id": "p3-4",
    "front": "What is one-hot encoding?",
    "back": "Converting categories into binary numeric columns",
    "topicId": "p3"
  },
  {
    "id": "p3-5",
    "front": "Normalization rescales data to what range?",
    "back": "0 to 1",
    "topicId": "p3"
  },
  {
    "id": "p3-6",
    "front": "What is feature engineering?",
    "back": "Creating new informative input variables using domain knowledge",
    "topicId": "p3"
  },
  {
    "id": "p3-7",
    "front": "What is labeling?",
    "back": "Attaching correct answers for supervised learning",
    "topicId": "p3"
  },
  {
    "id": "p3-8",
    "front": "Rotating/flipping images to expand data is called?",
    "back": "Data augmentation",
    "topicId": "p3"
  },
  {
    "id": "p3-9",
    "front": "Three dataset splits?",
    "back": "Training, validation, test",
    "topicId": "p3"
  },
  {
    "id": "p3-10",
    "front": "Which split must remain untouched until the end?",
    "back": "Test set",
    "topicId": "p3"
  },
  {
    "id": "p3-11",
    "front": "Test info leaking into training is called?",
    "back": "Data leakage",
    "topicId": "p3"
  },
  {
    "id": "p3-12",
    "front": "When should outliers be preserved?",
    "back": "Anomaly/fraud detection use cases",
    "topicId": "p3"
  },
  {
    "id": "p3-13",
    "front": "ETL stands for?",
    "back": "Extract, Transform, Load",
    "topicId": "p3"
  },
  {
    "id": "p3-14",
    "front": "Technique for class imbalance oversampling?",
    "back": "SMOTE",
    "topicId": "p3"
  },
  {
    "id": "p3-15",
    "front": "Why automate preparation as pipelines?",
    "back": "CPMAI iterates — prep reruns every iteration and in production",
    "topicId": "p3"
  },
  {
