    "front": "ML type for finding hidden groups?",
    "back": "Unsupervised (clustering)",
    "topicId": "p4"
  },
  {
    "id": "p4-3",
    "front": "ML type using rewards and trial-error?",
    "back": "Reinforcement learning",
    "topicId": "p4"
  },
  {
    "id": "p4-4",
    "front": "Predicting a price is classification or regression?",
    "back": "Regression",
    "topicId": "p4"
  },
  {
